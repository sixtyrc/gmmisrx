# Plantilla de referencia -- copiar a .env y completar con valores reales.
# .env NUNCA se versiona (ver .gitignore). Este archivo si se versiona,
# como documentacion de que variables hacen falta.

# Django
ALLOWED_HOSTS=localhost,127.0.0.1,misrxgm.ctsoft.com.ar
# En el server de produccion: DJANGO_DEBUG=False y DJANGO_SECRET_KEY con un valor
# random propio (generarlo con: python -c "import secrets; print(secrets.token_urlsafe(50))")
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=

# Servicio de Email (Resend SMTP - Puerto 465/SSL)
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Notificaciones GM MisRx <gm_misrx@ctsoft.com.ar>
NOTIFICACIONES_EMAIL_TO=

# Postgres de GeneXus (solo lectura, rol misrx_padron_ro) - origen del padron
GX_DB_HOST=
GX_DB_PORT=5432
GX_DB_NAME=
GX_DB_USER=misrx_padron_ro
GX_DB_PASSWORD=

# Postgres propio de esta app (historial de corridas, auditoria, excepciones)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Convenios validos para el padron (lista separada por coma)
CONVENIOS_VALIDOS=NAV

# API MisRx (Basic Auth) - carga/consulta de padron
MISRX_BASE_URL=https://www.misvalidaciones.com.ar
MISRX_USER=
MISRX_PASSWORD=
MISRX_CONVENIO_ID=

# OpenWA (WhatsApp self-hosted)
OPENWA_BASE_URL=https://openwa.dacio.com.ar
OPENWA_SESSION_ID=
OPENWA_KEY=
NOTIFICACIONES_WHATSAPP_TO=

# Usuario admin inicial del panel (solo se usa una vez, al crear con
# crear_usuarios_iniciales; se puede vaciar despues).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
